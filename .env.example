# Engram application runtime
DATABASE_URL=postgresql://engram:***@localhost:5432/engram
ENGRAM_JWT_SECRET=change...cret
ENGRAM_URL=http://localhost:3104
ENGRAM_COOKIE_DOMAIN=
ENGRAM_INTERNAL_API_KEY=change...-key
# Cite enrollment consumer + RS256 signing configuration. These are distinct
# server-to-server credentials; never expose them to browsers or commit values.
ENGRAM_AXON_ENROLLMENT_API_KEY=change...-axon-enrollment-key
ENGRAM_ENROLLMENT_SIGNING_KEY_ID=cite-enrollment-k1
ENGRAM_ENROLLMENT_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ENGRAM_ENROLLMENT_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ENGRAM_ENROLLMENT_SIGNING_NOT_BEFORE=2026-01-01T00:00:00Z
ENGRAM_ENROLLMENT_SIGNING_NOT_AFTER=2027-01-01T00:00:00Z
# Optional bounded prior-key overlap. Set all four together during rotation.
ENGRAM_ENROLLMENT_OVERLAP_SIGNING_KEY_ID=
ENGRAM_ENROLLMENT_OVERLAP_SIGNING_PUBLIC_KEY=
ENGRAM_ENROLLMENT_OVERLAP_SIGNING_NOT_BEFORE=
ENGRAM_ENROLLMENT_OVERLAP_SIGNING_NOT_AFTER=
# Dev/test-only. Enables POST /api/admin/native-auth-codes for fixture smoke.
ENGRAM_ENABLE_NATIVE_AUTH_FIXTURE=0

# Comma-separated list of additional origins allowed to make credentialed
# cross-origin requests to Engram (CORS). The hosted tenant apps load the
# shared @cortex-mesh/app-header (cortex ADR-102) from <org>.dev.ctxhost.com
# and call GET /api/me/app-switcher with credentials: "include", so every
# tenant host must be enumerated here (literal strings — no wildcards).
# Example:
# ENGRAM_ALLOWED_ORIGINS=https://cortex.dev.ctxhost.com,https://acme.dev.ctxhost.com
ENGRAM_ALLOWED_ORIGINS=

# OAuth providers
ENGRAM_GOOGLE_CLIENT_ID=
ENGRAM_GOOGLE_CLIENT_SECRET=
ENGRAM_GITHUB_CLIENT_ID=
ENGRAM_GITHUB_CLIENT_SECRET=

# Email
RESEND_API_KEY=***
RESEND_WEBHOOK_SECRET=whsec_...
EMAIL_FROM=Engram <noreply@ctxhost.com>
EMAIL_VERIFIED_DOMAINS=ctxhost.com

# App launcher / workspace URLs
NEXT_PUBLIC_DASHBOARD_URL=
NEXT_PUBLIC_SYNAPSE_URL=
NEXT_PUBLIC_THOUGHTS_URL=
NEXT_PUBLIC_AXON_URL=
NEXT_PUBLIC_PULSE_URL=
NEXT_PUBLIC_GYRUS_URL=
NEXT_PUBLIC_ENGRAM_DEFAULT_LANDING=
