{
  "name": "engram",
  "version": "0.65.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3104",
    "build": "next build",
    "build:opennext": "open-next build",
    "start": "next start --port 3104",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:auth-layout": "playwright install chromium && node scripts/auth-layout-playwright.mjs",
    "test:auth-layout:lifecycle": "node scripts/auth-layout-lifecycle-check.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "prisma:generate": "prisma generate",
    "seed:demo": "node scripts/seed-demo-tenant.mjs",
    "seed:demo:ally": "DEMO_TENANT_PRESET=ally node scripts/seed-demo-tenant.mjs",
    "seed:cortex-smoke-member": "node scripts/seed-cortex-smoke-member.mjs",
    "reconcile:cite-production-client": "node scripts/reconcile-cite-production-client.mjs",
    "gen:migrations-manifest": "node scripts/gen-migrations-manifest.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1086.0",
    "@aws-sdk/client-secrets-manager": "^3.1068.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^0.575.0",
    "nanoid": "^5.1.16",
    "next": "^16.4.2",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.12.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@opennextjs/aws": "^4.0.3",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "playwright": "^1.62.1",
    "postcss": "^8.5.25",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25"
    },
    "@prisma/dev": {
      "@hono/node-server": "2.0.11",
      "hono": "4.12.34",
      "fast-uri": "3.1.9"
    },
    "@prisma/streams-local": {
      "fast-uri": "3.1.9"
    },
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "5.0.9"
    },
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "sharp": "0.35.5",
    "valibot": "1.4.2",
    "nanoid@3": "3.3.18"
  }
}
