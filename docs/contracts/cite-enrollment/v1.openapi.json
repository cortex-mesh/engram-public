{
  "openapi": "3.1.0",
  "info": {
    "title": "Engram Cite the Move enrollment contract",
    "version": "1.0.0",
    "description": "The versioned, fail-closed contract by which Engram is the sole admission authority for the axon-web consumer. This document is the complete consumer contract; consumers must not import Engram implementation code or infer enrollment from organization, membership, entitlement, session, or UI state.",
    "x-contract-version": "1.0.0",
    "x-compatibility-policy": {
      "path-major-version": "v1",
      "additive-change": "New optional response fields, new optional request fields, and new error codes may be added in a minor contract release. Consumers must ignore unknown fields and deny any unknown signed enum value.",
      "breaking-change": "A changed meaning, removed field, required field, signature algorithm, canonicalization rule, or acknowledgement rule requires a new path major version and a new contract document.",
      "consumer-pin": "A consumer must pin the major path and accept only contract_version=1 in signed messages. It must fail closed for another contract_version.",
      "deprecation": "Engram will retain a supported major for at least the published overlap period. A retired major returns CONTRACT_VERSION_UNSUPPORTED and must not be silently downgraded."
    },
    "x-invariants": [
      "The only client represented by this contract is axon-web; the only application binding is axon. A credential or request for another client is forbidden and never falls back to axon-web.",
      "Only an active, unexpired, unrevoked enrollment assertion signed by Engram is an allow decision. Absence, any validation failure, or unavailable acknowledged state is a deny decision.",
      "Every enrollment mutation is an immutable event in one client-scoped, gap-free sequence. sequence starts at 1 and increases by exactly one; event_id is globally unique; prev_event_hash is the SHA-256 base64url hash of the prior signed JWS, or null only at sequence 1.",
      "The event, snapshot, and active assertion are compact JWS values. The protected header must have alg=RS256, typ=engram-enrollment+jws, kid, and contract_version=1. The payload is UTF-8 JSON with no alternate serialization accepted.",
      "Consumers verify the JWS before reading its claims, select only an active or overlap published key whose kid, use=sig, alg=RS256, contract_version=1, and validity interval match, and reject unknown, retired, mismatched, or expired keys. HMAC keys are never published or accepted.",
      "A snapshot is authoritative only after JWS verification and only when its head_sequence is not older than the consumer's durable acknowledged sequence. A stale snapshot must not overwrite newer state.",
      "Delivery is at-least-once. Duplicate delivery of an identical sequence, event_id, and signed_jws is idempotent; a duplicate sequence with different bytes, event_id, or hash is a conflict and must deny access pending reconciliation.",
      "An acknowledgement is durable only after the response returns status=acknowledged with the same sequence, event_id, and event_hash. Retrying that exact acknowledgement is idempotent. An acknowledgement never advances over an undispatched, missing, mismatched, or gapped event.",
      "After an overlap key is retired, Engram advances the retained cursor floor and deletes earlier events atomically while retaining the immutable current head. A cursor below that floor receives CURSOR_EXPIRED and must verify and acknowledge a snapshot signed by a currently published key; historical events signed solely by a retired key are never replayed.",
      "After Engram durably acknowledges a revocation, any Axon session bound to that enrollment must be denied on its next protected request. Axon must fail closed while it cannot establish or read its durable acknowledged enrollment state.",
      "All timestamps are RFC 3339 UTC instants. IDs and hashes are opaque case-sensitive strings. Consumers must use their own trusted clock, reject expired assertions and state_valid_until, and apply a maximum 60-second future-issued-at skew."
    ]
  },
  "servers": [
    {
      "url": "https://{engramOrigin}",
      "variables": { "engramOrigin": { "default": "login.dev.ctxhost.com" } }
    }
  ],
  "security": [{ "enrollmentConsumerAuth": [] }],
  "paths": {
    "/api/internal/enrollment/v1/keys": {
      "get": {
        "operationId": "getEnrollmentSigningKeys",
        "summary": "Get published enrollment verification keys",
        "responses": {
          "200": {
            "description": "Current and overlap verification keys.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/KeySetResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/WrongClient" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/internal/enrollment/v1/snapshot": {
      "get": {
        "operationId": "getEnrollmentSnapshot",
        "summary": "Get the signed current enrollment head for bootstrap or reconciliation",
        "responses": {
          "200": {
            "description": "A complete signed snapshot. It includes active and revoked enrollment records as of head_sequence.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SnapshotResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/WrongClient" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/internal/enrollment/v1/events": {
      "get": {
        "operationId": "listEnrollmentEvents",
        "summary": "Deliver ordered signed enrollment mutations after a durable cursor",
        "parameters": [
          { "$ref": "#/components/parameters/AfterSequence" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Events are strictly ascending, contiguous from after_sequence + 1, and may repeat a previously delivered item after retry.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EventPageResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidCursor" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/WrongClient" },
          "409": { "$ref": "#/components/responses/CursorExpired" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/internal/enrollment/v1/acknowledgements": {
      "post": {
        "operationId": "acknowledgeEnrollmentHead",
        "summary": "Durably acknowledge one verified, contiguous event or snapshot head",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcknowledgementRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The acknowledgement was durably stored, or an identical retry was read back.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcknowledgementResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidAcknowledgement" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/WrongClient" },
          "409": { "$ref": "#/components/responses/AcknowledgementConflict" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "enrollmentConsumerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Engram enrollment consumer credential",
        "description": "An Engram-issued server-to-server credential bound to consumer_id=axon and client_id=axon-web. The authenticated binding, not a caller-supplied client id, selects the data scope."
      }
    },
    "parameters": {
      "AfterSequence": {
        "name": "after_sequence",
        "in": "query",
        "required": true,
        "schema": { "type": "integer", "minimum": 0 },
        "description": "The consumer's durable acknowledged sequence. 0 begins at sequence 1 only while that sequence is retained; a cursor below the retained floor returns CURSOR_EXPIRED and requires signed snapshot reconciliation."
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 100
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Credential is missing, malformed, expired, or invalid.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": {
              "error": {
                "code": "UNAUTHENTICATED",
                "message": "Enrollment consumer authentication failed.",
                "retryable": false
              }
            }
          }
        }
      },
      "WrongClient": {
        "description": "Authenticated credential is not bound to axon-web, or a request attempts to cross that client boundary.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": {
              "error": {
                "code": "CLIENT_SCOPE_FORBIDDEN",
                "message": "Credential is not authorized for this enrollment stream.",
                "retryable": false
              }
            }
          }
        }
      },
      "Unavailable": {
        "description": "Engram cannot safely read or durably write the required enrollment state. Consumers must deny protected access rather than use stale or unacknowledged state.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": {
              "error": {
                "code": "ENROLLMENT_STATE_UNAVAILABLE",
                "message": "Enrollment state is temporarily unavailable.",
                "retryable": true
              }
            }
          }
        }
      },
      "InvalidCursor": {
        "description": "Cursor is missing or invalid.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "CursorExpired": {
        "description": "Requested cursor predates retained history. The response does not contain events; fetch and verify a signed snapshot before acknowledging its head.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": {
              "error": {
                "code": "CURSOR_EXPIRED",
                "message": "Cursor requires signed snapshot reconciliation.",
                "retryable": true
              }
            }
          }
        }
      },
      "InvalidAcknowledgement": {
        "description": "Acknowledgement shape is invalid or its event/hash cannot be parsed.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "AcknowledgementConflict": {
        "description": "Acknowledgement is not contiguous, has not been delivered, does not match Engram's immutable event, attempts to regress, or conflicts with an already stored acknowledgement. No acknowledgement was advanced.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "KeySetResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract_version", "keys"],
        "properties": {
          "contract_version": { "const": 1 },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/EnrollmentJwk" }
          }
        }
      },
      "EnrollmentJwk": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kty",
          "n",
          "e",
          "kid",
          "alg",
          "use",
          "contract_version",
          "not_before",
          "not_after",
          "status"
        ],
        "properties": {
          "kty": { "const": "RSA" },
          "n": { "type": "string", "minLength": 1 },
          "e": { "type": "string", "minLength": 1 },
          "kid": { "type": "string", "minLength": 1 },
          "alg": { "const": "RS256" },
          "use": { "const": "sig" },
          "contract_version": { "const": 1 },
          "not_before": { "type": "string", "format": "date-time" },
          "not_after": { "type": "string", "format": "date-time" },
          "status": { "enum": ["active", "overlap"] }
        }
      },
      "EventPageResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_version",
          "after_sequence",
          "head_sequence",
          "events"
        ],
        "properties": {
          "contract_version": { "const": 1 },
          "after_sequence": { "type": "integer", "minimum": 0 },
          "head_sequence": { "type": "integer", "minimum": 0 },
          "events": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SignedEventEnvelope" }
          }
        }
      },
      "SignedEventEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "event_id", "event_hash", "signed_jws"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "event_id": { "type": "string", "minLength": 1 },
          "event_hash": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "SHA-256 base64url hash of signed_jws bytes."
          },
          "signed_jws": {
            "type": "string",
            "pattern": "^[^.]+\\.[^.]+\\.[^.]+$"
          }
        }
      },
      "SnapshotResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_version",
          "head_sequence",
          "head_event_id",
          "head_event_hash",
          "signed_jws"
        ],
        "properties": {
          "contract_version": { "const": 1 },
          "head_sequence": { "type": "integer", "minimum": 0 },
          "head_event_id": { "type": ["string", "null"] },
          "head_event_hash": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "signed_jws": {
            "type": "string",
            "pattern": "^[^.]+\\.[^.]+\\.[^.]+$"
          }
        }
      },
      "AcknowledgementRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_version",
          "head_sequence",
          "head_event_id",
          "head_event_hash",
          "head_jws_hash"
        ],
        "properties": {
          "contract_version": { "const": 1 },
          "head_sequence": { "type": "integer", "minimum": 0 },
          "head_event_id": { "type": ["string", "null"] },
          "head_event_hash": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "head_jws_hash": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "For an event this equals head_event_hash; for a snapshot it is the SHA-256 base64url hash of signed_jws."
          }
        }
      },
      "AcknowledgementResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_version",
          "status",
          "consumer_id",
          "client_id",
          "head_sequence",
          "head_event_id",
          "head_event_hash",
          "acknowledged_at"
        ],
        "properties": {
          "contract_version": { "const": 1 },
          "status": { "const": "acknowledged" },
          "consumer_id": { "const": "axon" },
          "client_id": { "const": "axon-web" },
          "head_sequence": { "type": "integer", "minimum": 0 },
          "head_event_id": { "type": ["string", "null"] },
          "head_event_hash": { "type": ["string", "null"] },
          "acknowledged_at": { "type": "string", "format": "date-time" }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "retryable"],
            "properties": {
              "code": {
                "enum": [
                  "UNAUTHENTICATED",
                  "CLIENT_SCOPE_FORBIDDEN",
                  "CONTRACT_VERSION_UNSUPPORTED",
                  "INVALID_CURSOR",
                  "CURSOR_EXPIRED",
                  "ACKNOWLEDGEMENT_INVALID",
                  "ACKNOWLEDGEMENT_CONFLICT",
                  "ENROLLMENT_STATE_UNAVAILABLE"
                ]
              },
              "message": { "type": "string" },
              "retryable": { "type": "boolean" }
            }
          }
        }
      },
      "EnrollmentAssertion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enrollment_id",
          "subject_id",
          "client_id",
          "status",
          "version",
          "issued_at",
          "state_valid_until",
          "expires_at"
        ],
        "properties": {
          "enrollment_id": { "type": "string", "minLength": 1 },
          "subject_id": {
            "type": "string",
            "minLength": 1,
            "description": "Engram User.id; consumers must bind it to the authenticated identity and never substitute email."
          },
          "client_id": { "const": "axon-web" },
          "status": { "enum": ["active", "revoked", "expired"] },
          "version": { "type": "integer", "minimum": 1 },
          "issued_at": { "type": "string", "format": "date-time" },
          "state_valid_until": {
            "type": "string",
            "format": "date-time",
            "description": "Signed poll budget boundary. Consumers must deny once this instant passes until they verify a fresh representation."
          },
          "expires_at": { "type": "string", "format": "date-time" },
          "revoked_at": { "type": "string", "format": "date-time" },
          "revocation_reason": { "type": "string", "maxLength": 256 }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "revoked" } } },
            "then": { "required": ["revoked_at"] }
          }
        ]
      }
    }
  },
  "x-signed-message-payloads": {
    "event": {
      "required": [
        "contract_version",
        "kind",
        "client_id",
        "sequence",
        "event_id",
        "occurred_at",
        "prev_event_hash",
        "enrollment"
      ],
      "properties": {
        "contract_version": { "const": 1 },
        "kind": {
          "enum": [
            "enrollment.granted",
            "enrollment.revoked",
            "enrollment.expired"
          ]
        },
        "client_id": { "const": "axon-web" },
        "sequence": { "type": "integer", "minimum": 1 },
        "event_id": { "type": "string" },
        "occurred_at": { "format": "date-time" },
        "prev_event_hash": { "type": ["string", "null"] },
        "enrollment": { "$ref": "#/components/schemas/EnrollmentAssertion" }
      }
    },
    "snapshot": {
      "required": [
        "contract_version",
        "kind",
        "client_id",
        "generated_at",
        "issued_at",
        "state_valid_until",
        "head_sequence",
        "head_event_id",
        "head_event_hash",
        "enrollments"
      ],
      "properties": {
        "contract_version": { "const": 1 },
        "kind": { "const": "enrollment.snapshot" },
        "client_id": { "const": "axon-web" },
        "generated_at": { "format": "date-time" },
        "issued_at": { "format": "date-time" },
        "state_valid_until": { "format": "date-time" },
        "head_sequence": { "type": "integer", "minimum": 0 },
        "head_event_id": { "type": ["string", "null"] },
        "head_event_hash": { "type": ["string", "null"] },
        "enrollments": {
          "type": "array",
          "items": { "$ref": "#/components/schemas/EnrollmentAssertion" }
        }
      }
    },
    "active_assertion": { "$ref": "#/components/schemas/EnrollmentAssertion" }
  },
  "x-enrollment-assertion-schema": {
    "$ref": "#/components/schemas/EnrollmentAssertion"
  }
}
